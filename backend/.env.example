DJANGO_SECRET_KEY=replace-with-a-long-random-production-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
CORS_ALLOWED_ORIGINS=https://example.com,https://www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
AUTH_TOKEN_MAX_AGE=2592000
FRONTEND_URL=https://example.com
PASSWORD_RESET_TIMEOUT=3600
PASSWORD_RESET_THROTTLE_RATE=5/hour

# Development can use django.core.mail.backends.console.EmailBackend.
# Production must use authenticated SMTP credentials from the hosting provider.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=NazRiy <no-reply@example.com>

# PostgreSQL is required in development, testing, CI, and production.
DB_ENGINE=postgres
DB_NAME=nazriy_db
DB_USER=nazriy_user
DB_PASSWORD=replace-me
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=60
# Use require for hosted PostgreSQL and leave blank for trusted local development.
DB_SSLMODE=

# Optional Supabase Storage for product, banner, and category uploads.
# Keep false until a bucket and server-side S3 credentials are configured.
USE_SUPABASE_STORAGE=false
SUPABASE_STORAGE_BUCKET=nazriy-media
SUPABASE_STORAGE_ENDPOINT_URL=https://YOUR_PROJECT_REF.storage.supabase.co/storage/v1/s3
SUPABASE_STORAGE_REGION=YOUR_PROJECT_REGION
SUPABASE_STORAGE_ACCESS_KEY=replace-with-server-side-s3-access-key
SUPABASE_STORAGE_SECRET_KEY=replace-with-server-side-s3-secret-key
SUPABASE_STORAGE_QUERYSTRING_AUTH=true
SUPABASE_STORAGE_URL_EXPIRY=3600

# Manual bKash verification. Never place a PIN, OTP, API password, or secret here.
BKASH_MERCHANT_NUMBER=01XXXXXXXXX
