{
  "rewrites": [
    { "source": "/admin", "destination": "https://nazriy-api.vercel.app/admin/" },
    { "source": "/admin/(.*)", "destination": "https://nazriy-api.vercel.app/admin/$1" },
    { "source": "/static/:path*", "destination": "https://nazriy-api.vercel.app/static/:path*" },
    { "source": "/media/:path*", "destination": "https://nazriy-api.vercel.app/media/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
